# FinRAG 本地开发配置示例（复制为 .env 后按需修改）

# PostgreSQL（pgvector）——注意端口 5433，与 DataCrew 的 5432 隔离
PG_DSN=postgresql://postgres:postgres@localhost:5433/finrag

# Embedding：local=本地 ONNX 模型（首次运行下载）；mock=确定性哈希向量（CI/离线）
EMBEDDING_MODE=mock

# 分块与检索参数（默认值见 app/core/config.py，一般不用改）
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP_CHARS=60
RETRIEVE_TOP_K=8
