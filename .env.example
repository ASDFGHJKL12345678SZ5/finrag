# FinRAG 本地开发配置示例（复制为 .env 后按需修改）

# PostgreSQL（pgvector）——注意端口 5433，与 DataCrew 的 5432 隔离
PG_DSN=postgresql://postgres:postgres@localhost:5433/finrag

# Embedding：local=本地 ONNX 模型（首次运行下载）；mock=确定性哈希向量（CI/离线）
EMBEDDING_MODE=mock

# 分块与检索参数（默认值见 app/core/config.py，一般不用改）
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP_CHARS=60
RETRIEVE_TOP_K=8

# API 安全（FR-8）：逗号分隔的 key 白名单；每个 key 每分钟令牌数
API_KEYS=dev-key-001
RATE_LIMIT_PER_MIN=20
# 前端源（CORS 收紧，不再用 *）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis（限流/缓存；不可用时限流 fail-open，不影响问答）
REDIS_URL=redis://localhost:6379/0

# Langfuse 可观测（留空 = 自动降级为日志，不阻塞问答）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

